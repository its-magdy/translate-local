{
  "name": "@translate-local/cli",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "bin": {
    "tl": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:bin": "bun build --compile --minify --sourcemap --bytecode --format=esm ./src/index.ts --outfile dist/tl",
    "dev": "bun run src/index.ts",
    "test": "bun test --pass-with-no-tests --timeout 30000",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@translate-local/adapters": "workspace:*",
    "@translate-local/core": "workspace:*",
    "@translate-local/shared": "workspace:*",
    "@translate-local/tui": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^6.0"
  }
}
